# =============================================================
# systemd 服务单元（服务器部署示例）
# 安装步骤:
#   1) 把项目放到 /opt/mcp-dbtools
#   2) python3 -m venv /opt/mcp-dbtools/.venv && \
#      /opt/mcp-dbtools/.venv/bin/pip install -r requirements.txt
#   3) 拷贝 .env.example 为 .env 并修改
#   4) bash scripts/build_bridge.sh   # 构建 Java 桥 bridge.jar（需 node + JDK 17+）
#   5) python scripts/download_drivers.py
#   6) sudo cp deploy/mcp-dbtools.service /etc/systemd/system/
#   7) sudo systemctl daemon-reload && sudo systemctl enable --now mcp-dbtools
#   8) 验证: curl http://<服务器IP>:8000/health
# =============================================================
[Unit]
Description=mcp-dbtools MCP Database Tools (JDBC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mcp-dbtools
EnvironmentFile=/opt/mcp-dbtools/.env
ExecStart=/opt/mcp-dbtools/.venv/bin/python -m mcp_dbtools --transport streamable-http
Restart=on-failure
RestartSec=5
# 安全加固建议
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
