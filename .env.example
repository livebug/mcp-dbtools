# ============ MCP 服务 ============
# 监听地址与端口（HTTP 服务，供远程客户端访问）
MCP_DBTOOLS_HOST=0.0.0.0
MCP_DBTOOLS_PORT=8000

# 传输方式: streamable-http | sse | stdio
MCP_DBTOOLS_TRANSPORT=streamable-http

# 可选的 HTTP Bearer Token（启用后远程 HTTP 调用需携带 Authorization: Bearer <token>）
MCP_DBTOOLS_AUTH_TOKEN=

# 数据源配置文件路径（默认 ./config/datasources.json）
MCP_DBTOOLS_CONFIG=config/datasources.json

# JDBC 驱动目录（默认 ./drivers）
MCP_DBTOOLS_DRIVERS_DIR=drivers

# 单次查询最大返回行数（默认 300，防一次性拉大数据量）
MCP_DBTOOLS_MAX_ROWS=300
# limit 参数允许的最大值（超限按此截断）
MCP_DBTOOLS_MAX_ROWS_LIMIT=10000

# ============ 连接池与并发 ============
# 每个数据源的 JDBC 连接池大小（多客户并发时复用）
MCP_DBTOOLS_POOL_SIZE=2

# ============ 熔断 ============
# 连续失败 N 次触发熔断，冷却后恢复
MCP_DBTOOLS_CIRCUIT_FAIL_THRESHOLD=3
MCP_DBTOOLS_CIRCUIT_COOLDOWN=30

# ============ 大数据量异步导出 ============
# 导出文件目录（start_export 生成的文本文件）
MCP_DBTOOLS_EXPORT_DIR=exports
# 单次导出最大行数
MCP_DBTOOLS_EXPORT_MAX_ROWS=100000
# 导出文件保留时长（秒，默认 1 天），后台自动清理过期文件
MCP_DBTOOLS_EXPORT_KEEP_SECONDS=86400
# 最多保留的导出文件数，超出删除最旧的
MCP_DBTOOLS_EXPORT_MAX_FILES=100

# 连接超时（秒）
MCP_DBTOOLS_CONNECT_TIMEOUT=30

# ============ 监控与审计 ============
# 执行历史环形缓冲条数（get_execution_history 可查最近 N 条）
MCP_DBTOOLS_HISTORY_SIZE=500
# 审计日志文件（JSONL），默认开启落盘；设为空可关闭（仅保留内存历史）
MCP_DBTOOLS_AUDIT_FILE=logs/audit.jsonl
# 审计 SQLite 数据库（人工审计页面 /audit 的查询数据源），空则禁用页面查询
MCP_DBTOOLS_AUDIT_DB=logs/audit.db
# 是否开放 HTTP /metrics 监控端点（true/false）
MCP_DBTOOLS_METRICS_ENABLED=true
# 审计 JSONL 单文件最大字节数（超过自动轮转为 .1/.2/...，默认 10MB）
MCP_DBTOOLS_AUDIT_MAX_BYTES=10485760
# 审计轮转保留的备份份数
MCP_DBTOOLS_AUDIT_BACKUP_COUNT=5

# ============ 健康检查与自动重连 ============
# 后台探活/自动重连间隔（秒）：定期对每个数据源执行 SELECT 1，断连自动重建
MCP_DBTOOLS_HEALTH_CHECK_INTERVAL=30

# ============ 限流（按客户端 IP）============
# 是否启用 QPS 限流（防止客户端无限调用打爆数据库）
MCP_DBTOOLS_RATE_LIMIT_ENABLED=true
# 每客户端每秒请求上限
MCP_DBTOOLS_RATE_LIMIT_QPS=10
# 突发令牌容量（允许短时突发）
MCP_DBTOOLS_RATE_LIMIT_BURST=20

# ============ 元数据结果缓存 ============
# list_schemas/list_tables/describe_table 缓存有效期（秒，默认 60；0 关闭）
MCP_DBTOOLS_META_CACHE_TTL=60
# 元数据缓存最大条目数
MCP_DBTOOLS_META_CACHE_MAX_ITEMS=256

# ============ 显式事务 ============
# 事务最大持续时间（秒），超时自动回滚并释放连接
MCP_DBTOOLS_TX_TIMEOUT=300

# ============ 服务日志（落盘 + 轮转）============
# 应用日志文件路径，默认 logs/app.log；设为空仅输出控制台（pm2 logs 查看）
MCP_DBTOOLS_LOG_FILE=logs/app.log
# 单日志文件最大字节数，超过自动轮转为 .1/.2/...
MCP_DBTOOLS_LOG_MAX_BYTES=10485760
# 日志轮转保留备份份数
MCP_DBTOOLS_LOG_BACKUP_COUNT=5

# ============ 脚本执行 ============
# SQL 脚本根目录（execute_script 只能执行此目录内的脚本文件）
MCP_DBTOOLS_SCRIPT_ROOT=scripts/sql

# ============ 数据源密码（安全存储）============
# 【推荐】密码加密存储：datasources.json 的 password 写成 {ENC:...}，此处配置解密密钥。
#   生成加密串：echo -n "明文" | python scripts/encrypt_password.py --stdin
#   密钥请妥善保管，勿提交到代码库；修改密钥后需重新生成各数据源密文。
MCP_DBTOOLS_SECRET_KEY=

# 兼容旧方式：密码明文放在环境变量，再以 {ENV:VAR} 引用（不推荐，见上）
GAUSS_PASSWORD=Gauss@123
TDH_PASSWORD=tdh
