# ============ MCP 服务 ============
# 监听地址与端口（HTTP 服务，供远程客户端访问）
MCP_DBTOOLS_HOST=0.0.0.0
MCP_DBTOOLS_PORT=8000

# 传输方式: streamable-http | sse | stdio
MCP_DBTOOLS_TRANSPORT=streamable-http

# 可选的 HTTP Bearer Token（启用后远程 HTTP 调用需携带 Authorization: Bearer <token>）
MCP_DBTOOLS_AUTH_TOKEN=

# 数据源配置文件路径（默认 ./config/datasources.json）
MCP_DBTOOLS_CONFIG=config/datasources.json

# JDBC 驱动目录（默认 ./drivers）
MCP_DBTOOLS_DRIVERS_DIR=drivers

# 单次查询最大返回行数（默认 300，防一次性拉大数据量）
MCP_DBTOOLS_MAX_ROWS=300
# limit 参数允许的最大值（超限按此截断）
MCP_DBTOOLS_MAX_ROWS_LIMIT=10000

# ============ 连接池与并发 ============
# 每个数据源的 JDBC 连接池大小（多客户并发时复用）
MCP_DBTOOLS_POOL_SIZE=2

# ============ 熔断 ============
# 连续失败 N 次触发熔断，冷却后恢复
MCP_DBTOOLS_CIRCUIT_FAIL_THRESHOLD=3
MCP_DBTOOLS_CIRCUIT_COOLDOWN=30

# ============ 大数据量异步导出 ============
# 导出文件目录（start_export 生成的文本文件）
MCP_DBTOOLS_EXPORT_DIR=exports
# 单次导出最大行数
MCP_DBTOOLS_EXPORT_MAX_ROWS=100000

# 连接超时（秒）
MCP_DBTOOLS_CONNECT_TIMEOUT=30

# ============ 监控与审计 ============
# 执行历史环形缓冲条数（get_execution_history 可查最近 N 条）
MCP_DBTOOLS_HISTORY_SIZE=500
# 审计日志文件（JSONL），默认开启落盘；设为空可关闭（仅保留内存历史）
MCP_DBTOOLS_AUDIT_FILE=logs/audit.jsonl
# 审计 SQLite 数据库（人工审计页面 /audit 的查询数据源），空则禁用页面查询
MCP_DBTOOLS_AUDIT_DB=logs/audit.db
# 是否开放 HTTP /metrics 监控端点（true/false）
MCP_DBTOOLS_METRICS_ENABLED=true

# ============ 脚本执行 ============
# SQL 脚本根目录（execute_script 只能执行此目录内的脚本文件）
MCP_DBTOOLS_SCRIPT_ROOT=scripts/sql

# ============ 数据源密码（可通过 {ENV:VAR} 引用）============
GAUSS_PASSWORD=Gauss@123
TDH_PASSWORD=tdh
