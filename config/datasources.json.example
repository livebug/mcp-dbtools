{
  "datasources": [
    {
      "name": "gaussdb_test",
      "type": "gaussdb",
      "description": "本地 Docker openGauss 测试库",
      "driver_class": "org.opengauss.Driver",
      "jdbc_url": "jdbc:opengauss://127.0.0.1:15432/testdb",
      "username": "gaussdb",
      "password": "{ENC:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx}",
      "jars": [
        "opengauss-jdbc-5.0.0-og.jar"
      ]
    },
    {
      "name": "tdh_inceptor",
      "type": "tdh",
      "description": "TDH Inceptor 测试环境（驱动需自行放置到 drivers/ 目录）",
      "driver_class": "com.transwarp.jdbc.jdbc.TWJdbcDriver",
      "jdbc_url": "jdbc:transwarp://127.0.0.1:10000/testdb",
      "username": "tdh",
      "password": "{ENC:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx}",
      "jars": [
        "inceptor-driver.jar"
      ]
    },
    {
      "name": "db2_test",
      "type": "db2",
      "description": "DB2 示例（驱动 db2jcc4.jar 需手动放入 drivers/）",
      "driver_class": "com.ibm.db2.jcc.DB2Driver",
      "jdbc_url": "jdbc:db2://127.0.0.1:50000/sample",
      "username": "db2inst1",
      "password": "{ENV:DB2_PASSWORD}",
      "jars": [
        "db2jcc4.jar"
      ]
    }
  ]
}